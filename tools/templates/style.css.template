:root{color-scheme:light;font-family:system-ui,"Microsoft YaHei",sans-serif;background:#f5f6f8;color:#242b3b}body{margin:0}main{max-width:720px;margin:12vh auto;padding:24px;line-height:1.7}h1{font-size:clamp(28px,5vw,44px)}button{font:inherit;padding:12px 20px;background:#344cda;color:white;border:0;border-radius:8px;cursor:pointer}:focus-visible{outline:3px solid #d77535;outline-offset:4px}
